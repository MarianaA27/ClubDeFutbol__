@startuml c4-2-contenedores
!include <C4/C4_Container>
' PaladinesFC — C4 Nivel 2: Contenedores (versión 2: cómo quedó el sistema)

LAYOUT_LEFT_RIGHT()
AddElementTag("mvp", $bgColor="#1f6f4a", $borderColor="#0f3d28", $fontColor="#ffffff", $legendText="Contenedor que aloja el MVP re-arquitecturado")
AddElementTag("nuevo", $bgColor="#2f5f8a", $borderColor="#1b3a57", $fontColor="#ffffff", $legendText="Nuevo en la re-arquitectura")
AddRelTag("nuevo", $textColor="#2f5f8a", $lineColor="#2f5f8a", $legendText="Relación nueva")

title PaladinesFC — Diagrama de Contenedores (C4 nivel 2) — Versión 2: sistema implementado

Person(admin, "Administradora del club", "Usuaria de la aplicación de escritorio")
System_Ext(cliente, "Cliente de la API", "Swagger UI, Postman u otro sistema")

System_Boundary(sistema, "PaladinesFC") {
    Container(app, "Aplicación de escritorio", "Python 3 · CustomTkinter · ClubFutbol.exe (PyInstaller)", "Pantallas del MVP sobre los servicios de aplicación; módulos legados sobre legado/crud.py.", $tags="mvp")
    Container(api, "API REST del MVP", "Python 3 · FastAPI · uvicorn (python run_api.py)", "26 endpoints de Jugadores, Jugador–Tutor, Tutores y Profesores. Swagger en /docs. Usa los MISMOS servicios que la aplicación.", $tags="nuevo")
    ContainerDb(bd, "ClubFutbolDB", "Microsoft SQL Server (instancia local)", "15 tablas + migraciones 001–004: TUTOR.estado, JUGADOR.eps, índices de reglas, retiro de procedimientos reemplazados y reparación de SP_AsignarJugadorPlantilla.")
    Container(config, "config.ini", "Archivo INI / variables PALADINES_DB_*", "Cadena de conexión externa (antes fijada en el código: SERVER=GIANY).", $tags="nuevo")
    Container(log, "Bitácora", "logs/paladinesfc.log (rotativo)", "Operaciones revertidas por la unidad de trabajo, con su causa.", $tags="nuevo")
}

Rel(admin, app, "Usa", "Ventanas y formularios")
Rel(cliente, api, "Usa", "HTTP/JSON", $tags="nuevo")
Rel(app, bd, "Lee y escribe; 1 transacción por operación", "pyodbc · ODBC 17/18")
Rel(api, bd, "Lee y escribe; 1 transacción por petición", "pyodbc · ODBC 17/18", $tags="nuevo")
Rel(app, config, "Lee al iniciar", "configparser", $tags="nuevo")
Rel(api, config, "Lee al iniciar", "configparser", $tags="nuevo")
Rel(app, log, "Escribe fallos y reversiones", "logging", $tags="nuevo")
Rel(api, log, "Escribe fallos y reversiones", "logging", $tags="nuevo")

SHOW_LEGEND()
footer Los dos contenedores ejecutan el mismo paquete src/paladinesfc: solo cambia el adaptador de presentación.
@enduml
