@startuml c4-1-contexto
!include <C4/C4_Context>
' PaladinesFC — C4 Nivel 1: Contexto (versión 2: cómo quedó el sistema)
' Editable: este archivo. Exportar: java -jar plantuml.jar -tpng -tsvg *.puml

LAYOUT_TOP_DOWN()
AddElementTag("mvp", $bgColor="#1f6f4a", $borderColor="#0f3d28", $fontColor="#ffffff", $legendText="Sistema que contiene el MVP re-arquitecturado")
AddElementTag("nuevo", $bgColor="#2f5f8a", $borderColor="#1b3a57", $fontColor="#ffffff", $legendText="Nuevo en la entrega final")
AddRelTag("nuevo", $textColor="#2f5f8a", $lineColor="#2f5f8a", $legendText="Relación nueva")

title PaladinesFC — Diagrama de Contexto (C4 nivel 1) — Versión 2: sistema implementado

Person(admin, "Administradora del club", "Propietaria del club de fútbol formativo. Usa la aplicación de escritorio: registra jugadores, acudientes, cuerpo técnico, plantillas, sesiones y pagos.")
Person_Ext(tutor, "Tutor / acudiente", "Padre, madre o responsable del jugador (menor de edad). No usa el sistema: entrega sus datos y pagos a la administradora.")
Person_Ext(profesor, "Profesor / entrenador", "Cuerpo técnico. No usa el sistema; sus datos y sesiones los registra la administradora.")
System_Ext(cliente, "Cliente de la API", "Swagger UI, Postman u otro sistema del club que consuma los datos del MVP por HTTP (JSON).", $tags="nuevo")

System(paladines, "PaladinesFC", "Gestión del club: aplicación de escritorio y API REST sobre los mismos servicios. MVP re-arquitecturado: Jugadores, Jugador–Tutor, Tutores y Profesores.", $tags="mvp")

Rel(admin, paladines, "Registra, consulta, edita y da de baja (inactivación lógica)", "Interfaz gráfica de escritorio")
Rel(cliente, paladines, "Consulta y opera el MVP", "HTTP/JSON · REST", $tags="nuevo")
Rel_Up(tutor, admin, "Entrega datos de contacto, parentesco y pagos", "En persona")
Rel_Up(profesor, admin, "Informa sesiones y asistencia", "En persona")

SHOW_LEGEND()
footer Sin servicios en la nube: todo corre en el equipo del club. Entrega final — Arquitectura de Sistemas — Universidad Católica Luis Amigó
@enduml
